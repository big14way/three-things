<!--
  Buttons under the writing slate. Horizon kit components (Panel, Button,
  ButtonIcon, ButtonLabel) and Lucide icons are bundled with IWSDK.
  The panel is placed at scale 0.1, so 10 units here are 1 cm in the room.
-->
<style>
  .root {
    flex-direction: column;
    width: 560px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    gap: 8px;
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .picks {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
</style>
<Panel class="root">
  <div class="row">
    <Button id="make" variant="primary">
      <ButtonIcon><Check></Check></ButtonIcon>
      <ButtonLabel id="make-label">Make card</ButtonLabel>
    </Button>
    <Button id="erase" variant="secondary">
      <ButtonIcon><Eraser></Eraser></ButtonIcon>
      <ButtonLabel>Erase</ButtonLabel>
    </Button>
    <Button id="ideas" variant="secondary">
      <ButtonIcon><Lightbulb></Lightbulb></ButtonIcon>
      <ButtonLabel>Ideas</ButtonLabel>
    </Button>
    <Button id="voice" variant="secondary" style="display: none">
      <ButtonIcon><Mic></Mic></ButtonIcon>
      <ButtonLabel>Say it</ButtonLabel>
    </Button>
    <Button id="exit" variant="tertiary">
      <ButtonIcon><LogOut></LogOut></ButtonIcon>
    </Button>
  </div>
  <div id="picks" class="picks">
    <Button id="pick0" variant="secondary" size="sm"><ButtonLabel>Move my body</ButtonLabel></Button>
    <Button id="pick1" variant="secondary" size="sm"><ButtonLabel>One hour of deep work</ButtonLabel></Button>
    <Button id="pick2" variant="secondary" size="sm"><ButtonLabel>Call someone I love</ButtonLabel></Button>
    <Button id="pick3" variant="secondary" size="sm"><ButtonLabel>Tidy one corner</ButtonLabel></Button>
    <Button id="pick4" variant="secondary" size="sm"><ButtonLabel>Read 10 pages</ButtonLabel></Button>
    <Button id="pick5" variant="secondary" size="sm"><ButtonLabel>Drink more water</ButtonLabel></Button>
  </div>
</Panel>
